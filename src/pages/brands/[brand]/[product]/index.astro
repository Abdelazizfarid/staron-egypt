---
import Layout from '../../../../layouts/Layout.astro';
import PageHero from '../../../../components/PageHero.astro';
import Pic from '../../../../components/Pic.astro';
import Icon from '../../../../components/Icon.astro';
import PostCards from '../../../../components/PostCards.astro';
import Cta from '../../../../components/Cta.astro';
import { products, B, M, applications, postsFor } from '../../../../data/site.js';
import { u, routes } from '../../../../data/url.js';
export const getStaticPaths = () => products.map((p) => ({ params: { brand: p.brand, product: p.slug }, props: { p } }));
const { p } = Astro.props;
const b = B[p.brand], m = M[b.material];
const apps = applications.filter((a) => a.products.includes(p.slug));
const ld = { '@context': 'https://schema.org', '@type': 'Product', name: `${b.name} ${p.name}`, brand: { '@type': 'Brand', name: b.name }, description: p.description, category: m.name };
---
<Layout title={`${b.name} ${p.name}`} description={`${b.name} ${p.name}: ${p.description}`} image={p.img} current="brands" jsonld={[ld]}>
  <PageHero k={p.img} title={`${b.name} ${p.name}`} text={p.description} crumbs={[['Brands', u('brands')], [b.name, routes.brand(b.slug)], [p.name]]} />

  <section class="sec wrap" aria-labelledby="s-h">
    <div class="split">
      <div class="l" data-reveal>
        <h2 class="h-sec" id="s-h">Why {b.name}</h2>
        <ul class="ticks" style="margin-top:32px">{b.strengths.map((s) => <li><Icon name="check" />{s}</li>)}</ul>
      </div>
      <div class="r" data-reveal>
        <h2 class="h-sec">Technical specifications</h2>
        <dl class="facts" style="margin:32px 0 40px">{p.specs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
        <h3 class="h-3" style="margin-bottom:16px">Documents</h3>
        <div class="docs">{p.docs.map((d) => <a href={u('contact', `?type=documents&doc=${encodeURIComponent(b.name + ' ' + p.name + ' – ' + d)}#form`)}>{d}<Icon name="doc" /></a>)}</div>
        {apps.length > 0 && <><h3 class="h-3" style="margin:40px 0 16px">Used for</h3><div class="chips">{apps.map((a) => <a href={routes.application(a.slug)}>{a.name}</a>)}</div></>}
      </div>
    </div>
  </section>

  <section class="sec wrap" aria-labelledby="c-h" data-rail>
    <div class="colhead" style="display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:32px" data-reveal>
      <h2 class="h-sec" id="c-h">Colours</h2>
      <div style="display:flex;gap:10px;align-items:center">
        <a class="link" href={routes.colors(p)}><span>View all {p.colors.length} colours</span><Icon name="arrow" /></a>
        <span class="qctrl" style="margin-left:12px"><button type="button" data-prev aria-label="Scroll colours left" style="background:var(--paper-2)"><Icon name="arrowL" /></button><button type="button" data-next aria-label="Scroll colours right" style="background:var(--paper-2)"><Icon name="arrow" /></button></span>
      </div>
    </div>
    <ul class="swatches" data-reveal>
      {p.colors.map((c) => <li class="sw"><div class="sw__chip" style={`--c:${c.hex}`}><Pic k={m.img} alt="" /></div><b>{c.name}</b><span>{c.code}</span></li>)}
    </ul>
  </section>

  <PostCards list={postsFor('products', p.slug)} heading="Related reading" />
  <Cta title="Need samples?" text="We send physical samples and colour chips to architects and consultants across Egypt, usually within three working days." />
</Layout>
