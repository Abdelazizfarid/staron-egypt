---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---
<Layout title="Privacy policy" description="Privacy policy for the Staron Egypt website." image="m-quartz">
  <PageHero k="desk" title="Privacy policy" text="Last updated 6 November 2026." crumbs={[['Privacy policy']]} />
  <section class="sec wrap"><div class="prose measure" data-reveal>
    <p class="lead">We collect only what you send us and use it only to answer you.</p>
    <h2>What we collect</h2><p>When you send a request, subscribe to the newsletter or email us, we receive the details you provide: name, company, email, phone and your message. The website itself does not set advertising cookies.</p>
    <h2>How we use it</h2><p>To reply to your request, prepare quotations, arrange appointments and, if you subscribed, send occasional project news. We do not sell or share your details with third parties outside our group and the manufacturers needed to answer you.</p>
    <h2>Your rights</h2><p>You may ask to see, correct or delete the information we hold about you at any time by writing to info@staronegypt.com.</p> 
  </div></section>
</Layout>
