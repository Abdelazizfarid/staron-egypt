---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---
<Layout title="Terms of use" description="Terms of use for the Staron Egypt website." image="m-quartz">
  <PageHero k="desk" title="Terms of use" text="Last updated 6 November 2026." crumbs={[['Terms of use']]} />
  <section class="sec wrap"><div class="prose measure" data-reveal>
     <p class="lead">This website describes the materials and services of Staron Egypt.</p>
    <h2>Information on this site</h2><p>Technical data, colours and images are for guidance. Colours on screen vary; always confirm with a physical sample and the manufacturer’s current data sheet before specifying.</p>
    <h2>Quotations</h2><p>Prices are given only in written quotations, which state their own validity and conditions.</p>
    <h2>Trademarks</h2><p>Staron, Belenco, Tarkett, CrownLam and AKS Profil are trademarks of their respective owners.</p>
  </div></section>
</Layout>
