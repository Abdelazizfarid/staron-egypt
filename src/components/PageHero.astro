---
import Pic from './Pic.astro';
import { u } from '../data/url.js';
// crumbs: [[label, href]] — last one is the current page (no link)
const { title, text, k, crumbs = [] } = Astro.props;
const all = [['Home', u()], ...crumbs];
const ld = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: all.map(([name, href], i) => ({ '@type': 'ListItem', position: i + 1, name, item: href ? new URL(href, Astro.site).href : undefined })),
};
---
<section class="phero">
  <div class="phero__frame">
    <Pic k={k} eager data-hero-img />
    <div class="phero__top"></div>
    <div class="phero__scrim"></div>
    <div class="phero__body">
      <div>
        <nav aria-label="Breadcrumb"><ol class="crumbs">{all.map(([l, h], i) => <li>{h && i < all.length - 1 ? <a href={h}>{l}</a> : <span aria-current="page">{l}</span>}</li>)}</ol></nav>
        <h1 data-split="now">{title}</h1>
      </div>
      {text && <p>{text}</p>}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</section>
